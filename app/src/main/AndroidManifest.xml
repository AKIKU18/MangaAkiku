<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MangaV5"
        tools:targetApi="31">
        <activity
            android:name=".MainActivitys.HistoryPage"
            android:exported="false" />
        <activity
            android:name=".MainActivitys.BookmarksPage"
            android:exported="true"/>
        <activity
            android:name=".MainActivitys.MangaPage"
            android:exported="true"/>
        <activity
            android:name=".MainActivitys.ChapterPage"
            android:exported="true"/>
        <activity
            android:name=".MainActivitys.HomePage"
            android:exported="true">

            <!-- 👇 THIS MUST BE INSIDE the <activity> tag -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>