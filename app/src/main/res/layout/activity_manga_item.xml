<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@android:color/transparent">

        <!-- Manga Cover -->
        <ImageView
            android:id="@+id/mangaCoverImage"
            android:layout_width="80dp"
            android:layout_height="110dp"
            android:scaleType="centerCrop"
            android:contentDescription="Manga Cover" />

        <!-- Text container -->
        <!-- Text container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <!-- Manga Source -->
            <TextView
                android:id="@+id/mangaSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Source"
                android:textSize="12sp"
                android:textColor="#FF5722"
                android:textStyle="italic"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- Manga Title -->
            <TextView
                android:id="@+id/mangaTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manga Title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- Scrollable description -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/mangaDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Long manga description goes here..."
                    android:textColor="#666"
                    android:textSize="14sp" />

            </androidx.core.widget.NestedScrollView>

            <!-- Last chapter -->
            <TextView
                android:id="@+id/lastChapter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last Chapter: -"
                android:textColor="#43A047"
                android:textSize="13sp"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>


        <!-- Bookmark star -->
        <ImageView
            android:id="@+id/bookmarkStar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_star_border"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Bookmark" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
