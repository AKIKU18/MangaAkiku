<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="true">

    <!-- Page title -->
    <TextView
        android:id="@+id/tv_page_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bookmarks"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/updateButtonCard"
        android:layout_width="110dp"
        android:layout_height="38dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="@id/tv_page_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_page_title"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Glass background -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@android:color/transparent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/glass_bg" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Button -->
        <Button
            android:id="@+id/btn_update"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:text="UPDATE"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center"/>
    </FrameLayout>
    <!-- Search Bar -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/search_bookmarks"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_page_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Loading text -->
    <TextView
        android:id="@+id/bookmark_loading_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:text="No match try again..."
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/recycler_bookmarks"
        app:layout_constraintEnd_toEndOf="@+id/recycler_bookmarks"
        app:layout_constraintStart_toStartOf="@+id/recycler_bookmarks"
        app:layout_constraintTop_toTopOf="@+id/recycler_bookmarks" />

    <!-- RecyclerView for bookmarks -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_bookmarks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/homeButtonCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_bookmarks" />

    <!-- Empty text for no bookmarks -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No bookmarks yet"
        android:textSize="18sp"
        android:textColor="@android:color/darker_gray"
        android:visibility="gone"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_page_title"
        app:layout_constraintBottom_toTopOf="@id/homeButtonCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Home button with glass effect -->
    <FrameLayout
        android:id="@+id/homeButtonCard"
        android:layout_width="200dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Glass background -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="28dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:id="@+id/bookmarkBlurBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/glass_bg" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Button -->
        <Button
            android:id="@+id/btn_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:text="HOME"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:textAllCaps="false" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
