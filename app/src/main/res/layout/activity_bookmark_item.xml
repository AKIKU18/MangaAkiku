<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/transparent">

        <!-- Cover Image -->
        <ImageView
            android:id="@+id/mangaCoverImage"
            android:layout_width="80dp"
            android:layout_height="110dp"
            android:scaleType="centerCrop"
            android:contentDescription="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <!-- Manga Source -->
            <TextView
                android:id="@+id/mangaSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Source: MangaDex"
                android:textSize="12sp"
                android:textColor="#FF5722"
                android:textStyle="italic"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- Manga Title -->
            <TextView
                android:id="@+id/mangaTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manga Title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Viewed and Current Chapters -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/viewedChapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Viewed: -"
                    android:textSize="14sp"
                    android:textColor="#43A047"
                    android:clickable="true"
                    android:focusable="true"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/currentChapter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Current: -"
                    android:textSize="14sp"
                    android:textColor="#1E88E5"
                    android:clickable="true"
                    android:focusable="true"
                    android:ellipsize="end"
                    android:maxLines="1" />

            </LinearLayout>

        </LinearLayout>

        <!-- Bookmark star icon -->
        <ImageView
            android:id="@+id/bookmarkStar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:contentDescription="Bookmark"
            android:src="@drawable/ic_bookmark_border"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="8dp"
        android:id="@+id/mangaBlurCard">
    </androidx.cardview.widget.CardView>
</androidx.cardview.widget.CardView>
