<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivitys.HomePage">

    <!-- MAIN CONTENT -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient"
        android:fitsSystemWindows="true">

        <!-- App Logo -->
        <ImageView
            android:id="@+id/app_logo"
            android:layout_width="48dp"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.264"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- App Title -->
        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MangaAkiku"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:layout_marginTop="12dp"/>

        <!-- Hamburger Menu Button -->
        <ImageButton
            android:id="@+id/button_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:padding="8dp"
            android:src="@drawable/ic_menu"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Notification Bell Button -->
        <ImageButton
            android:id="@+id/button_notifications"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notifications"
            android:padding="8dp"
            android:src="@drawable/ic_bell_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/button_settings_button"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"/>

        <!-- Notification Dropdown Frame -->
        <FrameLayout
            android:id="@+id/notification_dropdown"
            android:layout_width="250dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:background="@drawable/bg_gradient"
            android:elevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/button_notifications"
            app:layout_constraintEnd_toEndOf="@id/button_notifications"
            android:layout_marginTop="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:padding="8dp" />

        </FrameLayout>


        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/button_settings_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="8dp"
            android:src="@drawable/ic_settings_button"
            android:textColor="?android:attr/textColorPrimary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"/>

        <!-- Search Bar -->
        <androidx.appcompat.widget.SearchView
            android:id="@+id/search_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:queryHint="Search manga"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/app_title" />

        <!-- Main RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_main"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/search_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottom_buttons_container"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <!-- Search Results Frame -->
        <FrameLayout
            android:id="@+id/frameLayout"
            android:layout_width="408dp"
            android:layout_height="500dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/search_bar">

            <ImageView
                android:id="@+id/recycler_bg_blur"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="1"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_gradient_search"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_search_results"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:clipToPadding="false"
                android:padding="8dp"
                android:visibility="gone"
                app:cardCornerRadius="50dp" />
            <TextView
                android:id="@+id/loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- Bottom Buttons -->
        <LinearLayout
            android:id="@+id/bottom_buttons_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Bookmarks Button -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="28dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <View
                        android:id="@+id/bookmarkBlurBackground"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/glass_bg" />
                </com.google.android.material.card.MaterialCardView>

                <Button
                    android:id="@+id/button_bookmarks"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Bookmarks"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:background="@android:color/transparent"
                    android:gravity="center" />
            </FrameLayout>

            <!-- History Button -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="28dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <View
                        android:id="@+id/historyBlurBackground"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/glass_bg" />
                </com.google.android.material.card.MaterialCardView>

                <Button
                    android:id="@+id/button_history"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="History"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:background="@android:color/transparent"
                    android:gravity="center" />
            </FrameLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- LEFT DRAWER MENU -->
    <LinearLayout
        android:id="@+id/navigation_drawer"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient_search"
        android:alpha="1"
        android:padding="16dp"
        android:fitsSystemWindows="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Source"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <!-- MangaDex Drawer Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="10dp">

            <View
                android:id="@+id/drawer_mangadex_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/glow_around_button"
                android:visibility="gone"/>

            <Button
                android:id="@+id/source_mangadex"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="MangaDex"
                android:textColor="?android:attr/textColorPrimary"
                android:background="@drawable/bg_gradient"
                android:textSize="14sp"/>
        </FrameLayout>

        <!-- AsuraScans Drawer Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="10dp">

            <View
                android:id="@+id/drawer_asurascans_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/glow_around_button"
                android:visibility="gone"/>

            <Button
                android:id="@+id/source_asurascans"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient"
                android:text="AsuraScans"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- Manhuaus Drawer Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">

            <View
                android:id="@+id/drawer_manhuaus_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/glow_around_button"
                android:visibility="gone"/>

            <Button
                android:id="@+id/source_manhuaus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Manhuaus"
                android:textColor="?android:attr/textColorPrimary"
                android:background="@drawable/bg_gradient"
                android:textSize="14sp"/>
        </FrameLayout>

        <!-- ManhuaPlus Drawer Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp">

            <View
                android:id="@+id/drawer_manhuaPlus_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/glow_around_button"
                android:visibility="gone" />

            <Button
                android:id="@+id/source_manhuaPlus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="ManhuaPlus"
                android:textColor="?android:attr/textColorPrimary"
                android:background="@drawable/bg_gradient"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- DemonicScans Drawer Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp">

            <View
                android:id="@+id/drawer_demonicScans_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/glow_around_button"
                android:visibility="gone" />

            <Button
                android:id="@+id/source_demonicScans"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="DemonicScans"
                android:textColor="?android:attr/textColorPrimary"
                android:background="@drawable/bg_gradient"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- ManhuaFast Drawer Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp">

            <View
                android:id="@+id/drawer_manhuaFast_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/glow_around_button"
                android:visibility="gone" />

            <Button
                android:id="@+id/source_manhuaFast"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="ManhuaFast"
                android:textColor="?android:attr/textColorPrimary"
                android:background="@drawable/bg_gradient"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- FlameComics Drawer Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp">

            <View
                android:id="@+id/drawer_flameComics_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/glow_around_button"
                android:visibility="gone" />

            <Button
                android:id="@+id/source_flameComics"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="FlameComics"
                android:textColor="?android:attr/textColorPrimary"
                android:background="@drawable/bg_gradient"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- Rizzfables Drawer Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp">

            <View
                android:id="@+id/drawer_rizzfables_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/glow_around_button"
                android:visibility="gone" />

            <Button
                android:id="@+id/source_rizzfables"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Rizzfables"
                android:textColor="?android:attr/textColorPrimary"
                android:background="@drawable/bg_gradient"
                android:textSize="14sp" />
        </FrameLayout>


    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
