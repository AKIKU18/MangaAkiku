<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mangaPageLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Cover + Title Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Manga Cover -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/coverContainer"
            android:layout_width="379dp"
            android:layout_height="189dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/mangaCoverImagePage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="manga cover"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ProgressBar
                android:id="@+id/coverLoading"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Title and Bookmark -->
        <LinearLayout
            android:id="@+id/titleWithBookmarkPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/coverContainer">

            <TextView
                android:id="@+id/mangaTitlePage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Manga Title"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/bookmarkButtonPage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:contentDescription="Bookmark"
                android:src="@android:drawable/btn_star_big_off" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Description -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/descriptionScrollPage"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/mangaDescriptionPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full manga description here, can be long..."
                android:textColor="#666"
                android:textSize="16sp" />
        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/descriptionLoadingPage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Chapters container with RecyclerView and Scroll Button -->
    <FrameLayout
        android:id="@+id/chaptersContainerPage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chaptersRecyclerViewPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Scroll-to-Bottom Button at bottom right of chapters area -->
        <ImageButton
            android:id="@+id/scrollToBottomButtonPage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:backgroundTint="@color/teal_700"
            android:contentDescription="Scroll to bottom"
            android:src="@drawable/ic_arrow_downward" />

        <!-- Chapters loading spinner centered -->
        <ProgressBar
            android:id="@+id/chaptersLoadingPage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/firstChapterButtonPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#2196F3"
            android:text="First Chapter"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/lastChapterButtonPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#4CAF50"
            android:text="Last Chapter"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
